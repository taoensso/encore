;; No `:deps` here: bb's built-in `taoensso.encore` stub shadows any classpath
;; Encore, so declaring one has no effect on `bb-tests`.
{:paths ["bb"]
 :tasks
 {graal-tests
  {:doc "Run Graal native-image tests"
   :requires ([graal-tests])
   :task
   (do
     (graal-tests/uberjar)
     (graal-tests/native-image)
     (graal-tests/run-tests))}

  bb-tests
  {:doc "Run Babashka tests"
   :requires ([bb-tests])
   :task (bb-tests/run-tests)}}}
